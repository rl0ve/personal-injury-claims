<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.203.0-dev.8692">
  <bpmn:process id="Process_1" name="BPMN-Subrogation-Recovery" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="Var_Scenario" name="scenario" type="string" elementId="Event_start" default="" />
        <uipath:input id="Var_ClaimReference" name="claimReference" type="string" elementId="Event_start" default="" />
        <uipath:input id="Var_LiabilityBasisCode" name="liabilityBasisCode" type="string" elementId="Event_start" default="" />
        <uipath:inputOutput id="Var_RecoverableOutlayValue" name="recoverableOutlayValue" type="number" elementId="Process_1" />
        <uipath:inputOutput id="Var_RecoverableOutlayNote" name="recoverableOutlayNote" type="string" elementId="Process_1" />
        <uipath:inputOutput id="Var_ThirdPartyIdentified" name="thirdPartyIdentified" type="boolean" elementId="Process_1" />
        <uipath:inputOutput id="Var_DemandAmount" name="demandAmount" type="number" elementId="Process_1" />
        <uipath:inputOutput id="Var_DemandReference" name="demandReference" type="string" elementId="Process_1" />
        <uipath:inputOutput id="Var_Contested" name="contested" type="boolean" elementId="Process_1" />
        <uipath:inputOutput id="Var_RecoveredFromThirdParty" name="recoveredFromThirdParty" type="number" elementId="Process_1" />
        <uipath:inputOutput id="Var_RecoveryRouteNote" name="recoveryRouteNote" type="string" elementId="Process_1" />
        <uipath:output id="Var_RecoveryAmountReceived" name="recoveryAmountReceived" type="number" elementId="Event_end" />
        <uipath:output id="Var_ClaimStatus" name="claimStatus" type="string" elementId="Event_end" />
      </uipath:variables>
      <uipath:bindings version="v1" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="02feec65-7747-42e7-a022-dc014a66fda6" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_QuantifyOutlay" name="Quantify recoverable outlay" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"scenario":"=vars.Var_Scenario","liabilityBasisCode":"=vars.Var_LiabilityBasisCode"}]]></uipath:input>
          <uipath:output name="recoverableOutlayValue" type="number" var="Var_RecoverableOutlayValue" source="=result.response.value" />
          <uipath:output name="recoverableOutlayNote" type="string" var="Var_RecoverableOutlayNote" source="=result.response.note" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script><![CDATA[var s = scenario ? scenario : "Standard";
if (s === "Declined") {
  return { response: { value: 0, note: "Not applicable - liability declined, no outlay recoverable" } };
}
var value = 850;
var note = "Treatment costs and lost earnings itemised for recovery from the at-fault party";
if (s === "Investigated") {
  value = 1450;
  note = "Treatment costs itemised, recovery held pending investigation sign-off";
} else if (s === "Displaced") {
  value = 620;
  note = "Care and rehabilitation outlay itemised for recovery from the at-fault party";
}
return { response: { value: value, note: note } };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_SubrogationDemand" name="Issue subrogation demand" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"scenario":"=vars.Var_Scenario","claimReference":"=vars.Var_ClaimReference","liabilityBasisCode":"=vars.Var_LiabilityBasisCode"}]]></uipath:input>
          <uipath:output name="thirdPartyIdentified" type="boolean" var="Var_ThirdPartyIdentified" source="=result.response.thirdPartyIdentified" />
          <uipath:output name="demandAmount" type="number" var="Var_DemandAmount" source="=result.response.demandAmount" />
          <uipath:output name="demandReference" type="string" var="Var_DemandReference" source="=result.response.demandReference" />
          <uipath:output name="contested" type="boolean" var="Var_Contested" source="=result.response.contested" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:script><![CDATA[var s = scenario ? scenario : "Standard";
var ref = "SUB-" + (claimReference ? claimReference : "CLM-UNKNOWN");
if (s === "Declined") {
  return { response: { thirdPartyIdentified: false, demandAmount: 0, demandReference: ref + "-NONE", contested: false } };
}
var amount = 9200;
var contested = false;
if (s === "Investigated") {
  amount = 22400;
  contested = true;
} else if (s === "Underinsured") {
  amount = 6400;
} else if (s === "Displaced") {
  amount = 31500;
}
return { response: { thirdPartyIdentified: true, demandAmount: amount, demandReference: ref, contested: contested } };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gw_Contested" name="Recovery contested?" default="Flow_Negotiate">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Proceedings</bpmn:outgoing>
      <bpmn:outgoing>Flow_Negotiate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Negotiate" name="Negotiate settlement" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"demandAmount":"=vars.Var_DemandAmount","thirdPartyIdentified":"=vars.Var_ThirdPartyIdentified"}]]></uipath:input>
          <uipath:output name="recoveredFromThirdParty" type="number" var="Var_RecoveredFromThirdParty" source="=result.response.recovered" />
          <uipath:output name="recoveryRouteNote" type="string" var="Var_RecoveryRouteNote" source="=result.response.note" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Negotiate</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:script><![CDATA[if (thirdPartyIdentified !== true || !demandAmount) {
  return { response: { recovered: 0, note: "No pursuable at-fault party; negotiation not applicable" } };
}
var recovered = Math.round(demandAmount * 0.82);
return { response: { recovered: recovered, note: "Third-party insurer agreed negotiated settlement without litigation" } };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Proceedings" name="Issue proceedings" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"demandAmount":"=vars.Var_DemandAmount"}]]></uipath:input>
          <uipath:output name="recoveredFromThirdParty" type="number" var="Var_RecoveredFromThirdParty" source="=result.response.recovered" />
          <uipath:output name="recoveryRouteNote" type="string" var="Var_RecoveryRouteNote" source="=result.response.note" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Proceedings</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:script><![CDATA[var recovered = Math.round((demandAmount || 0) * 0.68);
return { response: { recovered: recovered, note: "County court proceedings issued and concluded in the insurer's favour, less legal costs" } };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gw_Merge" name="Recovery route resolved">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Reconcile" name="Reconcile recovery receipts" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"scenario":"=vars.Var_Scenario","recoverableOutlayValue":"=vars.Var_RecoverableOutlayValue","recoveredFromThirdParty":"=vars.Var_RecoveredFromThirdParty","contested":"=vars.Var_Contested"}]]></uipath:input>
          <uipath:output name="recoveryAmountReceived" type="number" var="Var_RecoveryAmountReceived" source="=result.response.recoveryAmountReceived" />
          <uipath:output name="claimStatus" type="string" var="Var_ClaimStatus" source="=result.response.claimStatus" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
      <bpmn:script><![CDATA[var s = scenario ? scenario : "Standard";
var total = (recoverableOutlayValue || 0) + (recoveredFromThirdParty || 0);
var status = "Recovery Complete - Subrogation Settled";
if (s === "Declined") {
  status = "No Recovery Pursued - Liability Declined";
} else if (s === "Underinsured") {
  status = "Recovery Complete - Subrogation Settled (Pro-Rata)";
} else if (contested === true) {
  status = "Recovery Complete - Proceedings Concluded";
} else if (s === "Reopened") {
  status = "Recovery Reopened - Subrogation Settled";
}
return { response: { recoveryAmountReceived: total, claimStatus: status } };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_end" name="Recovery reconciled">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_start" targetRef="Task_QuantifyOutlay" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_QuantifyOutlay" targetRef="Task_SubrogationDemand" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SubrogationDemand" targetRef="Gw_Contested" />
    <bpmn:sequenceFlow id="Flow_Proceedings" sourceRef="Gw_Contested" targetRef="Task_Proceedings">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Contested == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Negotiate" sourceRef="Gw_Contested" targetRef="Task_Negotiate" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Negotiate" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Proceedings" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gw_Merge" targetRef="Task_Reconcile" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Reconcile" targetRef="Event_end" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Event_end" bpmnElement="Event_end"><dc:Bounds x="1138" y="222.33333333333331" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start"><dc:Bounds x="252" y="222.33333333333331" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw_Contested" bpmnElement="Gw_Contested"><dc:Bounds x="638" y="215.33333333333331" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw_Merge" bpmnElement="Gw_Merge"><dc:Bounds x="888" y="215.33333333333331" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_QuantifyOutlay" bpmnElement="Task_QuantifyOutlay"><dc:Bounds x="338" y="200.33333333333334" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Negotiate" bpmnElement="Task_Negotiate"><dc:Bounds x="738" y="322" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Proceedings" bpmnElement="Task_Proceedings"><dc:Bounds x="738" y="192" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Reconcile" bpmnElement="Task_Reconcile"><dc:Bounds x="988" y="200.33333333333334" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_SubrogationDemand" bpmnElement="Task_SubrogationDemand"><dc:Bounds x="488" y="200.33333333333334" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_1" bpmnElement="Flow_1"><di:waypoint x="288" y="240.33333333333331" /><di:waypoint x="338" y="240.33333333333334" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_2" bpmnElement="Flow_2"><di:waypoint x="438" y="240.33333333333334" /><di:waypoint x="488" y="240.33333333333334" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_3" bpmnElement="Flow_3"><di:waypoint x="588" y="240.33333333333334" /><di:waypoint x="638" y="240.33333333333331" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_4" bpmnElement="Flow_4"><di:waypoint x="838" y="362" /><di:waypoint x="862" y="362" /><di:waypoint x="862" y="240.33333333333331" /><di:waypoint x="888" y="240.33333333333331" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_5" bpmnElement="Flow_5"><di:waypoint x="838" y="232" /><di:waypoint x="863" y="232" /><di:waypoint x="863" y="240.33333333333331" /><di:waypoint x="888" y="240.33333333333331" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_6" bpmnElement="Flow_6"><di:waypoint x="938" y="240.33333333333331" /><di:waypoint x="988" y="240.33333333333334" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_End" bpmnElement="Flow_End"><di:waypoint x="1088" y="240.33333333333334" /><di:waypoint x="1138" y="240.33333333333331" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Negotiate" bpmnElement="Flow_Negotiate"><di:waypoint x="688" y="240.33333333333331" /><di:waypoint x="712" y="240.33333333333331" /><di:waypoint x="712" y="362" /><di:waypoint x="738" y="362" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Proceedings" bpmnElement="Flow_Proceedings"><di:waypoint x="688" y="240.33333333333331" /><di:waypoint x="713" y="240.33333333333331" /><di:waypoint x="713" y="232" /><di:waypoint x="738" y="232" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
