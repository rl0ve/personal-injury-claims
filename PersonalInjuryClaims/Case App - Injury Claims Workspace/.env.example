# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Every value is optional: with none of them set the
# app runs entirely on the bundled demo dataset (src/lib/warranty/demoData.ts).
# Set the UiPath block to authenticate and read live Maestro case instances.
# ─────────────────────────────────────────────────────────────────────────────

# ── UiPath tenant ────────────────────────────────────────────────────────────
# baseUrl is the *api* host, not the portal. The portal origin sends no
# Access-Control-Allow-Origin, so from a browser every call dies in preflight.
# Identity answers on the api host too, so auth and data share this one value.
#
# The FUSION demo tenant, for reference:
#   VITE_UIPATH_BASE_URL=https://api.uipath.com
#   VITE_UIPATH_ORG_NAME=businessorchestration
#   VITE_UIPATH_TENANT_NAME=FUSION
VITE_UIPATH_BASE_URL=
VITE_UIPATH_ORG_NAME=
VITE_UIPATH_TENANT_NAME=
# Where *people* are sent: the "Open case run", Action Center and Jobs links.
# Blank derives it from the api host (api.→cloud., staging.api.→staging.), which
# is right for cloud and staging; set it for anything those rules miss.
VITE_UIPATH_PORTAL_URL=

# External App (OAuth, PKCE). Confidential secrets must never live here.
VITE_UIPATH_CLIENT_ID=
# Leave blank to use the app's own origin+path, which is what the UiPath Coded
# Apps host needs. Set it only when your External App registers a fixed URI.
VITE_UIPATH_REDIRECT_URI=
# OR.Jobs is what lets "New case" start a process; PIMS is Maestro; OR.Tasks is
# Action Center. Trim the rest if your External App is scoped tighter.
VITE_UIPATH_SCOPES=OR.Execution OR.Folders OR.Tasks OR.Jobs OR.Users PIMS ConversationalAgents DataFabric.Data.Read DataFabric.Data.Write DataFabric.Schema.Read

# ── The case ─────────────────────────────────────────────────────────────────
# processKey (GUID) of the published WarrantyResolution case in Maestro. This is
# what CaseInstances.getAll filters on. Blank ⇒ demo dataset only.
VITE_CASE_PROCESS_KEY=
# The Orchestrator folder the case lives in. Also used to build the "Open case
# run" deep link, which the Maestro page needs to resolve the instance.
VITE_CASE_FOLDER_KEY=

# The process the "New case" button starts, with arguments
#   { demoScenario, demoRunId, ownerEmail }
# Both fall back to the case process and folder above, which is the common
# setup. Point them at a separate seeding process when one exists.
VITE_NEW_CASE_PROCESS_KEY=
VITE_NEW_CASE_FOLDER_KEY=

# ── Optional integrations ────────────────────────────────────────────────────
# Data Fabric entity holding case evidence documents (Documents tab).
VITE_EVIDENCE_ENTITY_ID=
# Webhook fired by "Simulate customer evidence upload" on the case detail.
# the storyboard's scene-15 event that wakes the case agent.
VITE_EVIDENCE_WEBHOOK_URL=

# ── Conversational agent (the "Ask AI" panel) ────────────────────────────────
# Both must be set for the panel to stream from a real agent; otherwise it
# answers from the local case context. AGENT_ID and FOLDER_ID are NUMERIC ids
# (not the folderKey GUID used above).
# The Conversational Agent behind "Ask about this case". Numeric agent release
# id and the folder holding it. Blank leaves the panel answering from the case
# in front of the reader. Needs the ConversationalAgents scope.
#   FUSION: VITE_ASSISTANT_AGENT_ID=162896 · VITE_ASSISTANT_FOLDER_ID=713281
VITE_ASSISTANT_AGENT_ID=
VITE_ASSISTANT_FOLDER_ID=
