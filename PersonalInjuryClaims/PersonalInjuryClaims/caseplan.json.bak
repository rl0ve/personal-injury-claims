{
    "id": "case-ZguptzNomq",
    "version": "27.0.0",
    "name": "PersonalPropertyClaims",
    "description": "Manages a personal-lines property insurance claim from first notice of loss through settlement and closure. Covers buildings, contents and alternative accommodation across the standard peril set, with interrupting lanes for emergency mitigation, fraud investigation, coverage decline, hidden damage, authority escalation, complaints and catastrophe surge.",
    "metadata": {
        "caseIdentifier": "PC",
        "caseIdentifierType": "constant",
        "caseAppEnabled": true,
        "publishVersion": 2,
        "caseUnifiedSchemaEnabled": true,
        "caseDirectlyPassTaskOutputs": true,
        "intsvcActivityConfig": "v2",
        "slaRules": [
            {
                "id": "slaRoot0001",
                "displayName": "Property Claim Cycle SLA",
                "expression": "=js:true",
                "count": 180,
                "unit": "d",
                "escalationRule": [
                    {
                        "id": "esc_Rt0001",
                        "displayName": "Property Claim Cycle At Risk",
                        "triggerInfo": { "type": "at-risk", "atRiskPercentage": 70 },
                        "action": {
                            "type": "notification",
                            "recipients": [
                                { "scope": "User", "target": "354b6df6-3e7a-4a12-96ed-0b67afaa1bce", "value": "robert.love@uipath.com" }
                            ]
                        }
                    },
                    {
                        "id": "esc_Rt0002",
                        "displayName": "Property Claim Cycle Breached",
                        "triggerInfo": { "type": "sla-breached" },
                        "action": {
                            "type": "notification",
                            "recipients": [
                                { "scope": "UserGroup", "target": "35551807-06b1-4cda-90a1-2fb84851eee7", "value": "administrators" }
                            ]
                        }
                    }
                ]
            }
        ],
        "caseExitRules": [
            {
                "id": "Condition_CxRt01",
                "displayName": "Claim settled and closed",
                "rules": [
                    [{ "rule": "required-stages-completed", "id": "Rule_CxRt01" }]
                ],
                "marksCaseComplete": true
            },
            {
                "id": "Condition_CxRt02",
                "displayName": "Claim declined",
                "rules": [
                    [{ "rule": "selected-stage-completed", "id": "Rule_CxRt02", "selectedStageId": "Stage_Decl11" }]
                ],
                "marksCaseComplete": false
            },
            {
                "id": "Condition_CxRt03",
                "displayName": "Claim denied for fraud",
                "rules": [
                    [{ "rule": "selected-stage-completed", "id": "Rule_CxRt03", "selectedStageId": "Stage_Siu010", "conditionExpression": "=js:vars.restrictionOutcome === 'Authorised'" }]
                ],
                "marksCaseComplete": false
            }
        ]
    },
    "bindings": [
        { "id": "bCLM00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Claims Management Gateway", "default": "API - Claims Management Gateway", "propertyAttribute": "name" },
        { "id": "bCLM00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Claims Management Gateway", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bPOL00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Policy Administration Gateway", "default": "API - Policy Administration Gateway", "propertyAttribute": "name" },
        { "id": "bPOL00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Policy Administration Gateway", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bPRD00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Property Risk Data Gateway", "default": "API - Property Risk Data Gateway", "propertyAttribute": "name" },
        { "id": "bPRD00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Property Risk Data Gateway", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bVND00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Vendor Network Gateway", "default": "API - Vendor Network Gateway", "propertyAttribute": "name" },
        { "id": "bVND00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Vendor Network Gateway", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bSCR00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Screening and Bureau Gateway", "default": "API - Screening and Bureau Gateway", "propertyAttribute": "name" },
        { "id": "bSCR00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Screening and Bureau Gateway", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bRUL00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Rules", "default": "API - Rules", "propertyAttribute": "name" },
        { "id": "bRUL00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "Api", "resourceKey": "solution_folder.API - Rules", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bEMG00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "ProcessOrchestration", "resourceKey": "solution_folder.BPMN-Emergency-Mitigation-Dispatch", "default": "BPMN-Emergency-Mitigation-Dispatch", "propertyAttribute": "name" },
        { "id": "bEMG00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "ProcessOrchestration", "resourceKey": "solution_folder.BPMN-Emergency-Mitigation-Dispatch", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bSCP00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "ProcessOrchestration", "resourceKey": "solution_folder.BPMN-Scope-And-Settlement-Assembly", "default": "BPMN-Scope-And-Settlement-Assembly", "propertyAttribute": "name" },
        { "id": "bSCP00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "ProcessOrchestration", "resourceKey": "solution_folder.BPMN-Scope-And-Settlement-Assembly", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bREC00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "ProcessOrchestration", "resourceKey": "solution_folder.BPMN-Recoveries-And-Salvage", "default": "BPMN-Recoveries-And-Salvage", "propertyAttribute": "name" },
        { "id": "bREC00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "ProcessOrchestration", "resourceKey": "solution_folder.BPMN-Recoveries-And-Salvage", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bTRI00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "Agent", "resourceKey": "solution_folder.Agent - Claims Triage", "default": "Agent - Claims Triage", "propertyAttribute": "name" },
        { "id": "bTRI00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "Agent", "resourceKey": "solution_folder.Agent - Claims Triage", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bCOL00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "Agent", "resourceKey": "solution_folder.Agent - Cause of Loss Analysis", "default": "Agent - Cause of Loss Analysis", "propertyAttribute": "name" },
        { "id": "bCOL00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "Agent", "resourceKey": "solution_folder.Agent - Cause of Loss Analysis", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bRCV00001", "name": "name", "type": "string", "resource": "process", "resourceSubType": "Agent", "resourceKey": "solution_folder.Agent - Recovery Assessment", "default": "Agent - Recovery Assessment", "propertyAttribute": "name" },
        { "id": "bRCV00002", "name": "folderPath", "type": "string", "resource": "process", "resourceSubType": "Agent", "resourceKey": "solution_folder.Agent - Recovery Assessment", "default": "", "propertyAttribute": "folderPath" },
        { "id": "bAPP00001", "name": "name", "type": "string", "resource": "app", "resourceKey": "Shared.property-claims-console", "default": "property-claims-console", "propertyAttribute": "name" },
        { "id": "bAPP00002", "name": "folderPath", "type": "string", "resource": "app", "resourceKey": "Shared.property-claims-console", "default": "Shared", "propertyAttribute": "folderPath" }
    ],
    "variables": {
        "inputs": [
            { "id": "vScen0001", "name": "scenario", "type": "string", "default": "Standard", "elementId": "trigger_Start1" },
            { "id": "vRunI0001", "name": "runId", "type": "string", "default": "PC-RUN-0001", "elementId": "trigger_Start1" },
            { "id": "vOwnr0001", "name": "ownerEmail", "type": "string", "default": "robert.love@uipath.com", "elementId": "trigger_Start1" }
        ],
        "outputs": [
            { "id": "vOutc0001", "name": "caseOutcome", "type": "string", "var": "caseOutcome" },
            { "id": "vClos0001", "name": "closureReasonCode", "type": "string", "var": "closureReasonCode" }
        ],
        "inputOutputs": [
            { "id": "scenario", "name": "scenario", "type": "string", "elementId": "trigger_Start1" },
            { "id": "runId", "name": "runId", "type": "string", "elementId": "trigger_Start1" },
            { "id": "ownerEmail", "name": "ownerEmail", "type": "string", "elementId": "trigger_Start1" },
            { "id": "caseOutcome", "name": "caseOutcome", "type": "string", "default": "", "elementId": "root" },
            { "id": "closureReasonCode", "name": "closureReasonCode", "type": "string", "default": "", "elementId": "root" },
            { "id": "claimReference", "name": "claimReference", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "policyNumber", "name": "policyNumber", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "insuredName", "name": "insuredName", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "riskAddress", "name": "riskAddress", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "perilCode", "name": "perilCode", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "coverType", "name": "coverType", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "habitableFlag", "name": "habitableFlag", "type": "boolean", "custom": true, "elementId": "root", "default": "true" },
            { "id": "activeDamageFlag", "name": "activeDamageFlag", "type": "boolean", "custom": true, "elementId": "root", "default": "false" },
            { "id": "vulnerableCustomerFlag", "name": "vulnerableCustomerFlag", "type": "boolean", "custom": true, "elementId": "root", "default": "false" },
            { "id": "catEventCode", "name": "catEventCode", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "fraudScore", "name": "fraudScore", "type": "integer", "custom": true, "elementId": "root", "default": "0" },
            { "id": "claimStatus", "name": "claimStatus", "type": "string", "custom": true, "elementId": "root", "default": "Open" },
            { "id": "sumInsuredBuildings", "name": "sumInsuredBuildings", "type": "double", "custom": true, "elementId": "root", "default": "0" },
            { "id": "sumInsuredContents", "name": "sumInsuredContents", "type": "double", "custom": true, "elementId": "root", "default": "0" },
            { "id": "reserveBuildings", "name": "reserveBuildings", "type": "double", "custom": true, "elementId": "root", "default": "0" },
            { "id": "reserveContents", "name": "reserveContents", "type": "double", "custom": true, "elementId": "root", "default": "0" },
            { "id": "reserveAccommodation", "name": "reserveAccommodation", "type": "double", "custom": true, "elementId": "root", "default": "0" },
            { "id": "averageAppliedFlag", "name": "averageAppliedFlag", "type": "boolean", "custom": true, "elementId": "root", "default": "false" },
            { "id": "causeOfLossCode", "name": "causeOfLossCode", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "vacancyDays", "name": "vacancyDays", "type": "integer", "custom": true, "elementId": "root", "default": "0" },
            { "id": "floodCoverInForce", "name": "floodCoverInForce", "type": "boolean", "custom": true, "elementId": "root", "default": "true" },
            { "id": "coverageOutcome", "name": "coverageOutcome", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "settlementOutcome", "name": "settlementOutcome", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "settlementBasis", "name": "settlementBasis", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "settlementPath", "name": "settlementPath", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "estimatedCost", "name": "estimatedCost", "type": "double", "custom": true, "elementId": "root", "default": "0" },
            { "id": "authorityLimit", "name": "authorityLimit", "type": "double", "custom": true, "elementId": "root", "default": "0" },
            { "id": "hiddenDamageFound", "name": "hiddenDamageFound", "type": "boolean", "custom": true, "elementId": "root", "default": "false" },
            { "id": "supplementalScopeOutcome", "name": "supplementalScopeOutcome", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "restrictionOutcome", "name": "restrictionOutcome", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "closureOutcome", "name": "closureOutcome", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "subrogationPotentialFlag", "name": "subrogationPotentialFlag", "type": "boolean", "custom": true, "elementId": "root", "default": "false" },
            { "id": "recoveryAmountReceived", "name": "recoveryAmountReceived", "type": "double", "custom": true, "elementId": "root", "default": "0" },
            { "id": "complaintRef", "name": "complaintRef", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "decisionRationale", "name": "decisionRationale", "type": "string", "custom": true, "elementId": "root", "default": "" },
            { "id": "agentRationale", "name": "agentRationale", "type": "string", "custom": true, "elementId": "root", "default": "" }
        ]
    },
    "nodes": [
        {
            "id": "trigger_Start1",
            "type": "uipath.case.trigger",
            "data": {
                "parentElement": { "id": "root", "type": "case-management:root" },
                "description": "A handler or the claims console starts the case when a property loss is reported, selecting the journey to run and the owning handler.",
                "typeVersion": "1.0.0",
                "display": { "label": "Report a property loss" },
                "inputs": {
                    "serviceType": "None",
                    "outputs": [
                        { "name": "scenario", "type": "string", "source": "=vars.vScen0001", "var": "scenario" },
                        { "name": "runId", "type": "string", "source": "=vars.vRunI0001", "var": "runId" },
                        { "name": "ownerEmail", "type": "string", "source": "=vars.vOwnr0001", "var": "ownerEmail" }
                    ]
                }
            }
        },
        {
            "id": "Stage_Fnol01",
            "type": "case-management:Stage",
            "data": {
                "label": "FNOL & Claim Registration",
                "description": "Captures a complete first notice of loss, verifies policy and cover, screens for fraud and prior claims, and registers the claim with opening reserves.",
                "isRequired": true,
                "parentElement": { "id": "root", "type": "case-management:root" },
                "isInvalidDropTarget": false,
                "isPendingParent": false,
                "entryConditions": [
                    {
                        "id": "Condition_Fn0101",
                        "displayName": "Loss reported",
                        "rules": [[{ "rule": "case-entered", "id": "Rule_Fn0101" }]],
                        "isInterrupting": false
                    }
                ],
                "exitConditions": [
                    {
                        "id": "Condition_Fn0102",
                        "displayName": "Claim registered",
                        "rules": [[{ "rule": "required-tasks-completed", "id": "Rule_Fn0102" }]],
                        "type": "exit-only",
                        "marksStageComplete": true
                    }
                ],
                "slaRules": [
                    {
                        "id": "slaFnol0001",
                        "displayName": "FNOL Registration SLA",
                        "expression": "=js:true",
                        "count": 1,
                        "unit": "h",
                        "escalationRule": [
                            {
                                "id": "esc_Fn0001",
                                "displayName": "FNOL Registration At Risk",
                                "triggerInfo": { "type": "at-risk", "atRiskPercentage": 70 },
                                "action": { "type": "notification", "recipients": [{ "scope": "User", "target": "354b6df6-3e7a-4a12-96ed-0b67afaa1bce", "value": "robert.love@uipath.com" }] }
                            },
                            {
                                "id": "esc_Fn0002",
                                "displayName": "FNOL Registration Breached",
                                "triggerInfo": { "type": "sla-breached" },
                                "action": { "type": "notification", "recipients": [{ "scope": "UserGroup", "target": "35551807-06b1-4cda-90a1-2fb84851eee7", "value": "administrators" }] }
                            }
                        ]
                    }
                ],
                "tasks": [
                    [
                        {
                            "id": "tFN010001",
                            "type": "api-workflow",
                            "displayName": "Create claim shell",
                            "elementId": "Stage_Fnol01-tFN010001",
                            "isRequired": true,
                            "shouldRunOnlyOnce": true,
                            "entryConditions": [
                                { "id": "cFN010001", "displayName": "Case started", "rules": [[{ "rule": "runs-sequentially", "id": "rFN010001" }]] }
                            ],
                            "data": {
                                "name": "=bindings.bCLM00001",
                                "folderPath": "=bindings.bCLM00002",
                                "inputs": [
                                    { "name": "requestSource", "type": "string", "id": "iFN010101", "var": "requestSource", "elementId": "Stage_Fnol01-tFN010001", "value": "CreateClaimShell" },
                                    { "name": "scenario", "type": "string", "id": "iFN010102", "var": "scenario", "elementId": "Stage_Fnol01-tFN010001", "value": "=vars.scenario" },
                                    { "name": "runId", "type": "string", "id": "iFN010103", "var": "runId", "elementId": "Stage_Fnol01-tFN010001", "value": "=vars.runId" }
                                ],
                                "outputs": [
                                    { "name": "claimReference", "type": "string", "id": "claimReference", "var": "claimReference", "originalVar": "claimReference", "value": "claimReference", "source": "=claimReference", "target": "=claimReference", "elementId": "Stage_Fnol01-tFN010001" },
                                    { "name": "insuredName", "type": "string", "id": "insuredName", "var": "insuredName", "originalVar": "insuredName", "value": "insuredName", "source": "=insuredName", "target": "=insuredName", "elementId": "Stage_Fnol01-tFN010001" },
                                    { "name": "riskAddress", "type": "string", "id": "riskAddress", "var": "riskAddress", "originalVar": "riskAddress", "value": "riskAddress", "source": "=riskAddress", "target": "=riskAddress", "elementId": "Stage_Fnol01-tFN010001" },
                                    { "name": "perilCode", "type": "string", "id": "perilCode", "var": "perilCode", "originalVar": "perilCode", "value": "perilCode", "source": "=perilCode", "target": "=perilCode", "elementId": "Stage_Fnol01-tFN010001" },
                                    { "name": "claimStatus", "type": "string", "id": "claimStatus", "var": "claimStatus", "originalVar": "claimStatus", "value": "claimStatus", "source": "=claimStatus", "target": "=claimStatus", "elementId": "Stage_Fnol01-tFN010001" }
                                ]
                            }
                        }
                    ],
                    [
                        {
                            "id": "tFN010002",
                            "type": "api-workflow",
                            "displayName": "Verify policy and cover",
                            "elementId": "Stage_Fnol01-tFN010002",
                            "isRequired": true,
                            "shouldRunOnlyOnce": false,
                            "entryConditions": [
                                { "id": "cFN010002", "displayName": "Policy workstream opens", "rules": [[{ "rule": "current-stage-entered", "id": "rFN010002" }]] }
                            ],
                            "data": {
                                "name": "=bindings.bPOL00001",
                                "folderPath": "=bindings.bPOL00002",
                                "inputs": [
                                    { "name": "requestSource", "type": "string", "id": "iFN010201", "var": "requestSource2", "elementId": "Stage_Fnol01-tFN010002", "value": "PolicyInForceCheck" },
                                    { "name": "scenario", "type": "string", "id": "iFN010202", "var": "scenario2", "elementId": "Stage_Fnol01-tFN010002", "value": "=vars.scenario" },
                                    { "name": "claimReference", "type": "string", "id": "iFN010203", "var": "claimReference2", "elementId": "Stage_Fnol01-tFN010002", "value": "=vars.claimReference" }
                                ],
                                "outputs": [
                                    { "name": "policyNumber", "type": "string", "id": "policyNumber", "var": "policyNumber", "originalVar": "policyNumber", "value": "policyNumber", "source": "=policyNumber", "target": "=policyNumber", "elementId": "Stage_Fnol01-tFN010002" },
                                    { "name": "coverType", "type": "string", "id": "coverType", "var": "coverType", "originalVar": "coverType", "value": "coverType", "source": "=coverType", "target": "=coverType", "elementId": "Stage_Fnol01-tFN010002" },
                                    { "name": "sumInsuredBuildings", "type": "double", "id": "sumInsuredBuildings", "var": "sumInsuredBuildings", "originalVar": "sumInsuredBuildings", "value": "sumInsuredBuildings", "source": "=sumInsuredBuildings", "target": "=sumInsuredBuildings", "elementId": "Stage_Fnol01-tFN010002" },
                                    { "name": "sumInsuredContents", "type": "double", "id": "sumInsuredContents", "var": "sumInsuredContents", "originalVar": "sumInsuredContents", "value": "sumInsuredContents", "source": "=sumInsuredContents", "target": "=sumInsuredContents", "elementId": "Stage_Fnol01-tFN010002" },
                                    { "name": "vacancyDays", "type": "integer", "id": "vacancyDays", "var": "vacancyDays", "originalVar": "vacancyDays", "value": "vacancyDays", "source": "=vacancyDays", "target": "=vacancyDays", "elementId": "Stage_Fnol01-tFN010002" },
                                    { "name": "floodCoverInForce", "type": "boolean", "id": "floodCoverInForce", "var": "floodCoverInForce", "originalVar": "floodCoverInForce", "value": "floodCoverInForce", "source": "=floodCoverInForce", "target": "=floodCoverInForce", "elementId": "Stage_Fnol01-tFN010002" }
                                ]
                            }
                        },
                        {
                            "id": "tFN010003",
                            "type": "api-workflow",
                            "displayName": "Capture peril and damage detail",
                            "elementId": "Stage_Fnol01-tFN010003",
                            "isRequired": true,
                            "shouldRunOnlyOnce": false,
                            "entryConditions": [
                                { "id": "cFN010003", "displayName": "Loss detail workstream opens", "rules": [[{ "rule": "current-stage-entered", "id": "rFN010003" }]] }
                            ],
                            "data": {
                                "name": "=bindings.bCLM00001",
                                "folderPath": "=bindings.bCLM00002",
                                "inputs": [
                                    { "name": "requestSource", "type": "string", "id": "iFN010301", "var": "requestSource3", "elementId": "Stage_Fnol01-tFN010003", "value": "CaptureLossDetail" },
                                    { "name": "scenario", "type": "string", "id": "iFN010302", "var": "scenario3", "elementId": "Stage_Fnol01-tFN010003", "value": "=vars.scenario" },
                                    { "name": "claimReference", "type": "string", "id": "iFN010303", "var": "claimReference3", "elementId": "Stage_Fnol01-tFN010003", "value": "=vars.claimReference" }
                                ],
                                "outputs": [
                                    { "name": "habitableFlag", "type": "boolean", "id": "habitableFlag", "var": "habitableFlag", "originalVar": "habitableFlag", "value": "habitableFlag", "source": "=habitableFlag", "target": "=habitableFlag", "elementId": "Stage_Fnol01-tFN010003" },
                                    { "name": "activeDamageFlag", "type": "boolean", "id": "activeDamageFlag", "var": "activeDamageFlag", "originalVar": "activeDamageFlag", "value": "activeDamageFlag", "source": "=activeDamageFlag", "target": "=activeDamageFlag", "elementId": "Stage_Fnol01-tFN010003" },
