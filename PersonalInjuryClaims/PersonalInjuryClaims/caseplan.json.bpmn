      <bpmn:task id="CaseManagerNode" name="CaseManager">
        <bpmn:extensionElements>
          <uipath:tags>
            <uipath:tag key="caseVisible">true</uipath:tag>
          </uipath:tags>
          <uipath:activity version="v1">
            <uipath:type value="Maestro.CaseManagerPlaceholder" version="v1" />
            <uipath:context>
              <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"caseRulesDecisions":{"type":"object"},"caseCurrentExecutionState":{"type":"object"}},"required":[]}]]></uipath:inputSchema>
            </uipath:context>
            <uipath:input name="caseManagerInput" type="json" target="body"><![CDATA[{"caseRulesDecisions":"=js:(vars.caseRulesDecisions)","caseCurrentExecutionState":"=js:({ \"version\": 1, \"eventIdentifier\": vars.EventSubProcessEventIdentifier, \"event\": { \"type\": vars.EventSubProcessLatestEventType, \"parameters\": vars.EventSubProcessLatestEventParams, \"isExternal\": (vars.EventSubProcessLatestEventType == \"TaskCompleted\" || vars.EventSubProcessLatestEventType == \"SlaStatusChange\") ? false : true }, \"state\": { ...vars.caseState, \"vars\": { \"dataManager\": { \"scenario\": (vars.scenario), \"runId\": (vars.runId), \"ownerEmail\": (vars.ownerEmail), \"caseOutcome\": (vars.caseOutcome), \"closureReasonCode\": (vars.closureReasonCode), \"claimReference\": (vars.claimReference), \"policyNumber\": (vars.policyNumber), \"claimantName\": (vars.claimantName), \"incidentLocation\": (vars.incidentLocation), \"injuryTypeCode\": (vars.injuryTypeCode), \"coverType\": (vars.coverType), \"independentLivingFlag\": (vars.independentLivingFlag), \"activeDamageFlag\": (vars.activeDamageFlag), \"vulnerableCustomerFlag\": (vars.vulnerableCustomerFlag), \"litigationEventCode\": (vars.litigationEventCode), \"fraudScore\": (vars.fraudScore), \"claimStatus\": (vars.claimStatus), \"policyLimitIndemnity\": (vars.policyLimitIndemnity), \"policyLimitCosts\": (vars.policyLimitCosts), \"reserveGeneralDamages\": (vars.reserveGeneralDamages), \"reserveSpecialDamages\": (vars.reserveSpecialDamages), \"reserveCareAndRehab\": (vars.reserveCareAndRehab), \"contributoryNegligenceFlag\": (vars.contributoryNegligenceFlag), \"liabilityBasisCode\": (vars.liabilityBasisCode), \"notificationDelayDays\": (vars.notificationDelayDays), \"liabilityCoverInForce\": (vars.liabilityCoverInForce), \"liabilityOutcome\": (vars.liabilityOutcome), \"settlementOutcome\": (vars.settlementOutcome), \"settlementBasis\": (vars.settlementBasis), \"settlementPath\": (vars.settlementPath), \"estimatedCost\": (vars.estimatedCost), \"authorityLimit\": (vars.authorityLimit), \"hiddenDamageFound\": (vars.hiddenDamageFound), \"supplementalTreatmentOutcome\": (vars.supplementalTreatmentOutcome), \"restrictionOutcome\": (vars.restrictionOutcome), \"closureOutcome\": (vars.closureOutcome), \"subrogationPotentialFlag\": (vars.subrogationPotentialFlag), \"recoveryAmountReceived\": (vars.recoveryAmountReceived), \"complaintRef\": (vars.complaintRef), \"decisionRationale\": (vars.decisionRationale), \"agentRationale\": (vars.agentRationale) }, \"Create claim shell\": { \"claimReference\": (vars.claimReference), \"claimantName\": (vars.claimantName), \"incidentLocation\": (vars.incidentLocation), \"injuryTypeCode\": (vars.injuryTypeCode), \"claimStatus\": (vars.claimStatus) }, \"Verify policy and cover\": { \"policyNumber\": (vars.policyNumber), \"coverType\": (vars.coverType), \"policyLimitIndemnity\": (vars.policyLimitIndemnity), \"policyLimitCosts\": (vars.policyLimitCosts), \"notificationDelayDays\": (vars.notificationDelayDays), \"liabilityCoverInForce\": (vars.liabilityCoverInForce) }, \"Capture injury and incident detail\": { \"independentLivingFlag\": (vars.independentLivingFlag), \"activeDamageFlag\": (vars.activeDamageFlag), \"vulnerableCustomerFlag\": (vars.vulnerableCustomerFlag) }, \"Screen for fraud and prior claims\": { \"fraudScore\": (vars.fraudScore), \"litigationEventCode\": (vars.litigationEventCode) }, \"Confirm registration and set reserves\": { \"reserveGeneralDamages\": (vars.reserveGeneralDamages), \"reserveSpecialDamages\": (vars.reserveSpecialDamages), \"reserveCareAndRehab\": (vars.reserveCareAndRehab), \"claimStatus\": (vars.claimStatus2) }, \"Assign handling track\": { \"claimStatus\": (vars.claimStatus3), \"agentRationale\": (vars.agentRationale) }, \"Assign injury claims handler\": { \"claimStatus\": (vars.claimStatus4) }, \"Request supplementary evidence\": { \"claimStatus\": (vars.claimStatus5) }, \"Retrieve injury severity data\": { \"notificationDelayD