h\": (vars.stageSla_Emergency_Treatment___Early_Intervention_slaEmrg0001?.Emergency_Response_Breached?.endTimeEpoch) } }, \"stageSla_SIU___Investigative_Restriction_slaSiur0001\": { \"slaStatus\": (vars.stageSla_SIU___Investigative_Restriction_slaSiur0001?.slaStatus), \"Investigation_Referral_At_Risk\": { \"startTimeEpoch\": (vars.stageSla_SIU___Investigative_Restriction_slaSiur0001?.Investigation_Referral_At_Risk?.startTimeEpoch), \"endTimeEpoch\": (vars.stageSla_SIU___Investigative_Restriction_slaSiur0001?.Investigation_Referral_At_Risk?.endTimeEpoch) }, \"Investigation_Referral_Breached\": { \"startTimeEpoch\": (vars.stageSla_SIU___Investigative_Restriction_slaSiur0001?.Investigation_Referral_Breached?.startTimeEpoch), \"endTimeEpoch\": (vars.stageSla_SIU___Investigative_Restriction_slaSiur0001?.Investigation_Referral_Breached?.endTimeEpoch) } }, \"stageSla_Condition_Deterioration___Re_assessment_slaHidn0001\": { \"slaStatus\": (vars.stageSla_Condition_Deterioration___Re_assessment_slaHidn0001?.slaStatus), \"Supplemental_Treatment_At_Risk\": { \"startTimeEpoch\": (vars.stageSla_Condition_Deterioration___Re_assessment_slaHidn0001?.Supplemental_Treatment_At_Risk?.startTimeEpoch), \"endTimeEpoch\": (vars.stageSla_Condition_Deterioration___Re_assessment_slaHidn0001?.Supplemental_Treatment_At_Risk?.endTimeEpoch) }, \"Supplemental_Treatment_Breached\": { \"startTimeEpoch\": (vars.stageSla_Condition_Deterioration___Re_assessment_slaHidn0001?.Supplemental_Treatment_Breached?.startTimeEpoch), \"endTimeEpoch\": (vars.stageSla_Condition_Deterioration___Re_assessment_slaHidn0001?.Supplemental_Treatment_Breached?.endTimeEpoch) } }, \"stageSla_Complaint___Ombudsman_Referral_slaCmpl0001\": { \"slaStatus\": (vars.stageSla_Complaint___Ombudsman_Referral_slaCmpl0001?.slaStatus), \"Complaint_At_Risk\": { \"startTimeEpoch\": (vars.stageSla_Complaint___Ombudsman_Referral_slaCmpl0001?.Complaint_At_Risk?.startTimeEpoch), \"endTimeEpoch\": (vars.stageSla_Complaint___Ombudsman_Referral_slaCmpl0001?.Complaint_At_Risk?.endTimeEpoch) }, \"Complaint_Breached\": { \"startTimeEpoch\": (vars.stageSla_Complaint___Ombudsman_Referral_slaCmpl0001?.Complaint_Breached?.startTimeEpoch), \"endTimeEpoch\": (vars.stageSla_Complaint___Ombudsman_Referral_slaCmpl0001?.Complaint_Breached?.endTimeEpoch) } } } } })"}]]></uipath:input>
            <uipath:output name="caseManagerDecisions" type="jsonSchema" source="=result" var="caseManagerDecisions" custom="true" />
