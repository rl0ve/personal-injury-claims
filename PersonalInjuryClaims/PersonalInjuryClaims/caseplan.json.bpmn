      <bpmn:exclusiveGateway id="checkEndCaseGatewayNode">
        <bpmn:extensionElements>
          <uipath:skipObservability enabled="true" />
        </bpmn:extensionElements>
        <bpmn:incoming>edge_EventSubProcessRetrieveCaseStateNodePostCaseManager-checkEndCaseGatewayNode</bpmn:incoming>
