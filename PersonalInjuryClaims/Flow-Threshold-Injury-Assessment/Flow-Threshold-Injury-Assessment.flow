              {
                "name": "inputs.estimatedCost",
                "type": "number",
                "label": "estimatedCost"
              }
            ]
          }
        ]
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "description": "Selects the deterministic journey this claim follows, so the run is reproducible."
          },
          "liabilityBasisCode": {
            "type": "string",
            "description": "The liability position determined at assessment."
          },
          "subrogationPotentialFlag": {
            "type": "boolean",
            "description": "The subrogation recovery potential proposed at assessment \u2014 a candidate flag, not yet a pursuit decision."
          },
          "estimatedCost": {
            "type": "number",
            "description": "Estimated settlement value of the claim, general and special damages together, the basis for weighing pursuit against the minimum pursuit value."
          }
        }
      },
      "inputDefaults": {
        "scenario": "",
        "liabilityBasisCode": "",
        "subrogationPotentialFlag": false,
        "estimatedCost": 0
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "subrogationPotentialFlag": {
                "type": "boolean",
                "description": "Whether subrogation recovery is worth pursuing against the at-fault third party. This is the decision the case routes on \u2014 a real boolean, never a string."
              },
              "agentRationale": {
                "type": "string",
                "description": "The reasoning behind the pursuit decision, kept separate from the decision itself. This is what a person reads."
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
