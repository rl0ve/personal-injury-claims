      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "description": "Selects the deterministic journey this claim follows, so the run is reproducible."
          },
          "injuryTypeCode": {
            "type": "string",
            "description": "The injury reported at notification, such as whiplash, soft tissue, fracture, head injury or psychological."
          },
          "independentLivingFlag": {
            "type": "boolean",
            "description": "Whether the claimant can still live independently without care support."
          },
          "reserveGeneralDamages": {
            "type": "number",
            "description": "The general damages reserve for pain and suffering set at registration."
          },
          "litigationEventCode": {
            "type": "string",
            "description": "Litigation trigger identifier when proceedings or a pre-action protocol step are live on the claim. Empty when no litigation trigger applies."
          }
        }
      },
      "inputDefaults": {
        "scenario": "",
        "injuryTypeCode": "",
        "independentLivingFlag": false,
        "reserveGeneralDamages": 0,
        "litigationEventCode": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "claimStatus": {
                "type": "string",
                "description": "The handling track for this claim. Must be exactly one of: \"Desktop\", \"Field\", \"Specialist\", \"CAT Surge\". The case routes on this value, so it must never contain any other value.",
                "enum": [
                  "Desktop",
                  "Field",
                  "Specialist",
                  "CAT Surge"
                ]
              },
              "agentRationale": {
                "type": "string",
                "description": "The reasoning behind the handling track, kept separate from the decision itself. This is what a person reads."
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "debug": {
        "runtime": "bpmnEngine"
      }
    },
