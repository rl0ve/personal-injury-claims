{
  "id": "ce83433c-3eba-4746-b025-eeca24724d59",
  "version": "1.9",
  "name": "Flow-Threshold-Injury-Assessment",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "71022393-2821-4034-b0b6-9fc0dfb31cbe",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "readCaseAndClaimContext1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Read case and claim context"
      },
      "inputs": {
        "script": "",
        "code": "var ref = claimReference ? String(claimReference) : \"\";\nreturn { recordId: ref, document: documentName || \"\", hasContext: ref !== \"\" };"
      }
    },
    {
      "id": "normalizeReferralId1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Normalize Referral Id"
      },
      "inputs": {
        "script": "",
        "code": "var raw = String(claimReference || \"\");\nreturn raw.replace(/[^A-Za-z0-9-]/g, \"\").toUpperCase();"
      }
    },
    {
      "id": "processInjuryReportPacketIxp1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Process Injury Report Packet (IXP)"
      },
      "inputs": {
        "script": "",
        "code": "var name = documentName ? String(documentName) : \"medical-records.pdf\";\nreturn { packet: name, pages: 6 };"
      }
    },
    {
      "id": "analyzeMedicalReport1",
      "type": "uipath.core.agent.b224b58b-c800-4cca-9396-95876f6ac114",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Analyze medical report"
      },
      "inputs": {
        "scenario": "Standard",
        "injuryTypeCode": "WHIPLASH",
        "independentLivingFlag": true,
        "reserveGeneralDamages": 8500,
        "litigationEventCode": "NONE"
      }
    },
    {
      "id": "langchainAnalyzeAccidentDetails1",
      "type": "uipath.core.agent.f81ec540-7503-4f0c-a9b1-d66a84daa8a8",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Langchain-Analyze accident details"
      },
      "inputs": {
        "scenario": "Standard",
        "injuryTypeCode": "WHIPLASH",
        "notificationDelayDays": 3,
        "liabilityCoverInForce": true
      }
    },
    {
      "id": "analysisComplete1",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Analysis complete"
      },
      "inputs": {}
    },
    {
      "id": "injuryAssessmentAgent1",
      "type": "uipath.core.agent.ba6829b0-010a-4849-815e-8c03c745b8ab",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Vertex-Injury Assessment Agent"
      },
      "inputs": {
        "scenario": "Standard",
        "liabilityBasisCode": "FULL_LIABILITY",
        "subrogationPotentialFlag": true,
        "estimatedCost": 17400
      }
    },
    {
      "id": "setInjuryId1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Set Injury Id"
      },
      "inputs": {
        "script": "",
        "code": "var suffix = String(thresholdOutcome || \"GEN\").replace(/[^A-Z]/g, \"\").slice(0,3) || \"GEN\";\nreturn \"INJ-\" + suffix + \"-\" + String(referralId || \"0000\").slice(-4);"
      }
    },
    {
      "id": "recordInjuryAssessmentOnTheCase1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Record injury assessment on the case"
      },
      "inputs": {
        "script": "",
        "code": "return { recorded: true, injuryId: injuryId || \"\", against: referralId || \"\" };"
      }
    },
    {
      "id": "closeOutTheAssessment1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Close out the assessment"
      },
      "inputs": {
        "script": "",
        "code": "return { assessmentStatus: \"Complete\", injuryId: injuryId || \"\" };"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
