      "inputDefinition": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "description": "Selects the deterministic journey this claim follows, so the run is reproducible."
          },
          "injuryTypeCode": {
            "type": "string",
            "description": "The injury reported at notification, before medical evidence is obtained."
          },
          "notificationDelayDays": {
            "type": "integer",
            "description": "Days between the incident and notification of the claim."
          },
          "liabilityCoverInForce": {
            "type": "boolean",
            "description": "Whether liability cover applies under the policy."
          }
        }
      },
      "inputDefaults": {
        "scenario": "",
        "injuryTypeCode": "",
        "notificationDelayDays": 0,
        "liabilityCoverInForce": false
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "liabilityBasisCode": {
                "type": "string",
                "description": "The liability position determined from the evidence gathered. Must be exactly one of the listed values \u2014 never a variant spelling and never any other value.",
                "enum": [
                  "RearEndCollision",
                  "DriverInattention",
                  "UnsafePremises",
                  "DefectiveEquipment",
                  "ThirdPartyNegligence",
                  "FailureToGiveWay",
                  "PreExistingCondition",
                  "SharedFault"
                ]
              },
              "subrogationPotentialFlag": {
                "type": "boolean",
                "description": "True when the evidence points to a third party whose fault could support a subrogation recovery. This is a proposal only \u2014 it never decides coverage or whether pursuit is worthwhile."
              },
              "agentRationale": {
                "type": "string",
                "description": "The reasoning behind the liability position, including whether the evidence is ambiguous enough to need an independent medical examination or accident reconstruction. Kept separate from the decision itself; this is what a person reads."
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
