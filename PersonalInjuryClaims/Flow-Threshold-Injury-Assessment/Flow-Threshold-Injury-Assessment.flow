        "type": "object",
        "schema": {
          "type": "object",
          "properties": {
            "liabilityBasisCode": {
              "type": "string",
              "description": "The liability position determined from the evidence gathered. Must be exactly one of the listed values \u2014 never a variant spelling and never any other value.",
              "enum": [
                "RearEndCollision",
                "DriverInattention",
                "UnsafePremises",
                "DefectiveEquipment",
                "ThirdPartyNegligence",
                "FailureToGiveWay",
                "PreExistingCondition",
                "SharedFault"
              ]
            },
            "subrogationPotentialFlag": {
              "type": "boolean",
              "description": "True when the evidence points to a third party whose fault could support a subrogation recovery. This is a proposal only \u2014 it never decides coverage or whether pursuit is worthwhile."
            },
            "agentRationale": {
              "type": "string",
              "description": "The reasoning behind the liability position, including whether the evidence is ambiguous enough to need an independent medical examination or accident reconstruction. Kept separate from the decision itself; this is what a person reads."
